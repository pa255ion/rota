cabal-version:      3.0
name:               rota-web
version:            0.1.0.0
synopsis:           The desktop emulators' fast versions in the browser (side track W)
license:            MIT
build-type:         Simple

common web
  default-language: Haskell2010
  -- the Clash starter project's extensions, as the systems' .cabal files
  -- (docs/TOOLCHAIN.md), without Template Haskell
  default-extensions:
    BangPatterns BinaryLiterals ConstraintKinds DataKinds DefaultSignatures
    DeriveAnyClass DeriveDataTypeable DeriveFoldable DeriveFunctor
    DeriveGeneric DeriveLift DeriveTraversable DerivingStrategies
    InstanceSigs KindSignatures MagicHash NoStarIsType PolyKinds RankNTypes
    ScopedTypeVariables StandaloneDeriving TupleSections TypeApplications
    TypeFamilies TypeOperators ViewPatterns NoImplicitPrelude
  -- as the systems' own builds (their clash-common): every module's code
  -- visible to its importers, so a CPU core written against a bus class
  -- (the NES's 6502) is specialised to its machine there; without it the
  -- browser's NES ran its CPU generic, every bus access a dictionary call
  ghc-options: -fexpose-all-unfoldings
  build-depends:
    base,
    bytestring,
    vector

-- Each system's desktop library (W.3; W.1's Game Gear build, Web.Gg, gave
-- way to rota-sms, which runs it from the same code) (systems/<n>/desktop,
-- the C calls the desktop's Zig front end makes) compiled unchanged, with
-- Web.Alloc for the page's buffers. web/shim stands in for the two screen
-- modules that write PNGs (JuicyPixels, Clash's frame type), first in the
-- search path so the systems' own aren't used.

executable rota-gb
  import:           web
  main-is:          Gb.hs
  hs-source-dirs:   main src shim ../systems/gb/desktop ../systems/gb/src ../platform/src
  other-modules:
    Web.Alloc
    Gb.Cartridge
    Gb.Desktop
    Gb.Hooks
    Gb.Screen
    Gb.Spec
    Gb.Spec.Apu
    Gb.Spec.Cpu
    Gb.Spec.Machine
    Gb.Spec.Ppu
    Gb.Spec.State
    Gb.SpecFast
    Gb.SpecFast.Apu
    Gb.SpecFast.Cpu
    Gb.SpecFast.Machine
    Gb.SpecFast.Ppu
    Gb.SpecFast.State
    Platform.Snapshot
  ghc-options:
    -O2 -no-hs-main -optl-mexec-model=reactor
    "-optl-Wl,--export=hs_init,--export=web_alloc,--export=web_free,--export=gb_new,--export=gb_free,--export=gb_frame,--export=gb_audio,--export=gb_pixels,--export=gb_cram_size,--export=gb_cram_get,--export=gb_cram_set,--export=gb_state_save,--export=gb_state_get,--export=gb_state_load"

