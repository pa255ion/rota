cabal-version:      2.4
name:               w65c816
version:            0.1.0.0
synopsis:           Shared WDC 65C816 CPU: cycle-exact reference model (later a Clash core)
description:
  Shared by every 65C816 system (M7 Super Nintendo's 5A22 first, the SA-1
  later; docs/systems/snes.md). Knows nothing about any machine: the
  caller supplies the bus. Built like cpus/mos6502, which it doesn't change.
license:            BSD-2-Clause
build-type:         Simple

common clash-common
  default-language: Haskell2010
  -- Default extensions of the Clash starter project (docs/TOOLCHAIN.md)
  default-extensions:
    BangPatterns
    BinaryLiterals
    ConstraintKinds
    DataKinds
    DefaultSignatures
    DeriveAnyClass
    DeriveDataTypeable
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveLift
    DeriveTraversable
    DerivingStrategies
    InstanceSigs
    KindSignatures
    MagicHash
    NoStarIsType
    PolyKinds
    RankNTypes
    ScopedTypeVariables
    StandaloneDeriving
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    ViewPatterns
    TemplateHaskell
    QuasiQuotes
    NoImplicitPrelude
  ghc-options:
    -Wall -Wcompat
    -fplugin GHC.TypeLits.Normalise
    -fplugin GHC.TypeLits.KnownNat.Solver
    -fplugin GHC.TypeLits.Extra.Solver
    -fexpose-all-unfoldings
    -fno-worker-wrapper
    -fconstraint-solver-iterations=10
  build-depends:
    base,
    clash-prelude >= 1.8 && < 1.9,
    ghc-typelits-natnormalise,
    ghc-typelits-extra,
    ghc-typelits-knownnat

library
  import:           clash-common
  hs-source-dirs:   src
  exposed-modules:
    W65c816.Types
    W65c816.Spec
    W65c816.Core
    W65c816.CoreOoc
  ghc-options:      -O2
  build-depends:
    vector

-- Layer 0 (docs/TESTING.md): the reference model against Tom Harte's
-- SingleStepTests (tools/fetch-roms.sh, roms/65816/): final state and the
-- bus cycles of every test, per opcode and mode file (step 7.1).
test-suite w65c816-spec
  import:           clash-common
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  other-modules:
    W65c816.SingleStep
    W65c816.Interrupts
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N -O2
  build-depends:
    w65c816,
    aeson,
    bytestring,
    containers,
    directory,
    filepath,
    vector,
    tasty,
    tasty-hunit

-- Layer 1 (step 7.7): the Clash core against SingleStepTests and in
-- lockstep with the spec on random programs.
test-suite w65c816-core
  import:           clash-common
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Core.hs
  other-modules:
    W65c816.SingleStep
    W65c816.CoreStep
    W65c816.Lockstep
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N -O2
  build-depends:
    w65c816,
    aeson,
    bytestring,
    containers,
    directory,
    filepath,
    tasty,
    tasty-hunit
