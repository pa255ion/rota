cabal-version:      2.4
name:               z80
version:            0.1.0.0
synopsis:           Shared Zilog Z80 CPU: T-state exact reference model (later a Clash core)
description:
  Shared by every Z80 system (M5 Game Gear first; docs/systems/gamegear.md).
  Knows nothing about any machine: the caller supplies the bus.
license:            BSD-2-Clause
build-type:         Simple

common clash-common
  default-language: Haskell2010
  -- Default extensions of the Clash starter project (docs/TOOLCHAIN.md)
  default-extensions:
    BangPatterns
    BinaryLiterals
    ConstraintKinds
    DataKinds
    DefaultSignatures
    DeriveAnyClass
    DeriveDataTypeable
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveLift
    DeriveTraversable
    DerivingStrategies
    InstanceSigs
    KindSignatures
    MagicHash
    NoStarIsType
    PolyKinds
    RankNTypes
    ScopedTypeVariables
    StandaloneDeriving
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    ViewPatterns
    TemplateHaskell
    QuasiQuotes
    NoImplicitPrelude
  ghc-options:
    -Wall -Wcompat
    -fplugin GHC.TypeLits.Normalise
    -fplugin GHC.TypeLits.KnownNat.Solver
    -fplugin GHC.TypeLits.Extra.Solver
    -fexpose-all-unfoldings
    -fno-worker-wrapper
    -fconstraint-solver-iterations=10
  build-depends:
    base,
    clash-prelude >= 1.8 && < 1.9,
    ghc-typelits-natnormalise,
    ghc-typelits-extra,
    ghc-typelits-knownnat

library
  import:           clash-common
  hs-source-dirs:   src
  exposed-modules:
    Z80.Spec
    Z80.Core
  -- ZEXALL runs for billions of T-states.
  ghc-options:      -O2
  build-depends:
    vector

-- Layer 0 (docs/TESTING.md): the reference model against Tom Harte's
-- SingleStepTests (tools/fetch-roms.sh, roms/z80/): final state and the
-- machine cycles of every test, per opcode file.
test-suite z80-spec
  import:           clash-common
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  other-modules:
    Z80.SingleStep
    Z80.Interrupts
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N -O2
  build-depends:
    z80,
    aeson,
    bytestring,
    containers,
    directory,
    filepath,
    vector,
    tasty,
    tasty-hunit

-- Layer 0, FULL tier: ZEXDOC and ZEXALL under a CP/M stub (roms/z80/zex/);
-- the quick tier runs the first test of each.
test-suite z80-zex
  import:           clash-common
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Zex.hs
  ghc-options:      -threaded -rtsopts -O2
  build-depends:
    z80,
    bytestring,
    directory,
    vector,
    tasty,
    tasty-hunit

-- Layers 1 and 2 (step 5.5): the Clash core ("Z80.Core" as plain Haskell)
-- on SingleStepTests, and in lockstep with the reference model on random
-- programs with interrupts; deliberately broken cores must be caught.
test-suite z80-lockstep
  import:           clash-common
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Lockstep.hs
  other-modules:
    Z80.SingleStep
    Z80.CoreRun
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N -O2
  build-depends:
    z80,
    aeson,
    bytestring,
    containers,
    directory,
    filepath,
    vector,
    tasty,
    tasty-hunit
