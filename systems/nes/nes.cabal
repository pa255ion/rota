cabal-version:      2.4
name:               nes
version:            0.1.0.0
synopsis:           NES (NTSC) reference model and Clash core
license:            BSD-2-Clause
build-type:         Simple

common clash-common
  default-language: Haskell2010
  -- Default extensions of the Clash starter project (docs/TOOLCHAIN.md)
  default-extensions:
    BangPatterns
    BinaryLiterals
    ConstraintKinds
    DataKinds
    DefaultSignatures
    DeriveAnyClass
    DeriveDataTypeable
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveLift
    DeriveTraversable
    DerivingStrategies
    InstanceSigs
    KindSignatures
    MagicHash
    NoStarIsType
    PolyKinds
    RankNTypes
    ScopedTypeVariables
    StandaloneDeriving
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    ViewPatterns
    TemplateHaskell
    QuasiQuotes
    NoImplicitPrelude
  ghc-options:
    -Wall -Wcompat
    -fplugin GHC.TypeLits.Normalise
    -fplugin GHC.TypeLits.KnownNat.Solver
    -fplugin GHC.TypeLits.Extra.Solver
    -fexpose-all-unfoldings
    -fno-worker-wrapper
    -fconstraint-solver-iterations=10
  build-depends:
    base,
    clash-prelude >= 1.8 && < 1.9,
    ghc-typelits-natnormalise,
    ghc-typelits-extra,
    ghc-typelits-knownnat

library
  import:           clash-common
  hs-source-dirs:   src
  exposed-modules:
    Nes.Cartridge
    Nes.Hooks
    Nes.AccuracyCoin
    Nes.Palette
    Nes.Display
    Nes.Ppu
    Nes.Apu
    Nes.Mixer
    Nes.Audio
    Nes.Mapper
    Nes.Loader
    Nes.Core
    Nes.Top
    Nes.ArtyTop
    Nes.Screen
    Nes.Spec
    Nes.Spec.Machine
    Nes.Spec.Mapper
    Nes.Spec.Ppu
    Nes.Spec.Apu
    Nes.Spec.SaveState
    Nes.SpecFast.Machine
    Nes.SpecFast.Ppu
    Nes.SpecFast.Mapper
    Nes.SpecFast.Apu
    Nes.StateTable
    Nes.StateTap
    Nes.StateHooks
  ghc-options:      -O2
  build-depends:
    mos6502,
    platform,
    bytestring,
    containers,
    vector,
    JuicyPixels

-- Layer 0 (docs/TESTING.md): the test hooks and the reference model, on
-- the fetched test ROMs (tools/fetch-roms.sh) and on our own regression
-- ROMs (build/nes/asm/, assembled by make nes-asm).
test-suite nes-spec
  import:           clash-common
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  other-modules:
    Nes.TestRoms
    Nes.SpecRoms
    Nes.SpecMappers
    Nes.SpecPpu
    Nes.SpecLoader
    Nes.SpecApu
    Nes.SpecMapperel
    Nes.SpecRestore
    Nes.SpecEval
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    nes,
    mos6502,
    platform,
    bytestring,
    containers,
    vector,
    directory,
    filepath,
    JuicyPixels,
    tasty,
    tasty-hunit,
    tasty-golden,
    tasty-hedgehog,
    hedgehog,
    process

-- Run a ROM on the reference model and print Blargg's result:
-- cabal run nes-run -- <rom.nes> [CPU cycles]
executable nes-run
  import:           clash-common
  hs-source-dirs:   app
  main-is:          Run.hs
  ghc-options:      -O2 -rtsopts
  build-depends:
    nes,
    platform,
    bytestring

-- Side track Q (PLAN.md Q.7): the fast version (Nes.SpecFast) against the
-- reference model, instruction by instruction (EMU_FULL_TESTS=1: longer,
-- every Blargg test, Holy Mapperel ROM, AccuracyCoin).
test-suite nes-specfast
  import:           clash-common
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          SpecFast.hs
  other-modules:
    Nes.TestRoms
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N4 -M2g" -O2
  build-depends:
    nes,
    mos6502,
    platform,
    bytestring,
    vector,
    directory,
    filepath,
    tasty,
    tasty-golden,
    tasty-hunit

-- Side track Q (PLAN.md Q.7): where the reference model's time goes.
executable nes-fast-bench
  import:           clash-common
  hs-source-dirs:   app
  main-is:          FastBench.hs
  ghc-options:      -O2 -rtsopts
  build-depends:
    nes,
    bytestring,
    vector

-- Layer 2: the Clash PPU in lockstep with the reference model (step 3.5).
test-suite nes-lockstep
  import:           clash-common
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Lockstep.hs
  other-modules:
    Nes.TestRoms
    Nes.PpuHarness
    Nes.CoreHarness
    Nes.SpecMapperel
    Nes.LockState
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N -O2
  build-depends:
    nes,
    mos6502,
    platform,
    bytestring,
    vector,
    directory,
    filepath,
    JuicyPixels,
    tasty,
    tasty-hunit,
    tasty-golden,
    tasty-hedgehog,
    hedgehog,
    process

-- Block RAM images of a cartridge for make hdl / make sim (zedboard.mk):
-- cabal run nes-image -- <rom.nes> <dir>
executable nes-image
  import:           clash-common
  hs-source-dirs:   app
  main-is:          Image.hs
  build-depends:
    nes,
    bytestring,
    filepath

-- Layer 3 (step 3.7): VGA and HDMI goldens from the spec goldens, and the
-- display path in Clash simulation.
test-suite nes-golden
  import:           clash-common
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Golden.hs
  other-modules:
    Nes.TestRoms
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N -O2
  build-depends:
    nes,
    platform,
    bytestring,
    vector,
    directory,
    filepath,
    JuicyPixels,
    tasty,
    tasty-hunit,
    tasty-golden

-- Side track Q (PLAN.md Q.4): the reference model behind a C ABI, for
-- the desktop emulator's Zig front end (platform/desktop/; make desktop).
foreign-library nes-desktop
  type:             native-shared
  default-language: Haskell2010
  hs-source-dirs:   desktop
  other-modules:    Nes.Desktop
  ghc-options:      -O2 -Wall
  build-depends:
    platform,
    base,
    nes,
    bytestring,
    vector
