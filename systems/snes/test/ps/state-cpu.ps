# Save states at layer 4, the CPU build (M7 step 7.15c; Makefile
# ci-savestate-snes-cpu; SNES_STATES=cpu: the Arty's top with the hooks of
# a load through the CPU): as state.ps, with the CPU build's record, the
# table window (0x300000: the table and OAM's high table, 552 bytes: the
# status's record size) read through, the chain (0x300800: the sound
# module's record, 428 bytes), and the status's version 2.
#
# (state.ps's header follows)
# Save states at layer 4 (M7 step 7.14b; Makefile ci-savestate-snes; the
# Arty's top, which has the hooks): Snes.StateHooks's link map (the state
# mode 0x140050, the write window 0x200000 and the read window 0x300000:
# the chain from 0, CGRAM 0x1000, OAM 0x1200, DMA 0x1400, the DSP's
# samples 0x1500, the status 0x1F00, ARAM 0x10000, VRAM 0x20000, WRAM
# 0x40000; the read-back control 0x140000 for the byte channel).
#
# tone.sfc running (3 frames in: its sound program perhaps still going up
# to the SPC700); the menu pauses it, freeze (the core runs on to rest in
# V-blank: within a frame)
wait 50000
ctrl 2
bytes 0x140000 01
bytes 0x140050 01
wait 40000
# expected (test/ps/state.hex): the status (frozen, the chain's 1101
# bytes as 4D 04, version 1); a byte of each memory written and read
# back: WRAM $7F:FFF0 (25), VRAM word 8 (low chip 11, high 22), colour 3
# (1234: 34 12), OAM lane 1 of entry 1 (44), DMA channel 2's register 3
# (55), the DSP's sample 7 (0x6677: 77 66), ARAM $8000 (88)
bytes 0x301F00 00000000
bytes 0x25FFF0 25
bytes 0x35FFF0 00
bytes 0x220010 1122
bytes 0x320010 0000
bytes 0x201006 3412
bytes 0x301006 0000
bytes 0x201205 44
bytes 0x301205 00
bytes 0x201423 55
bytes 0x301423 00
bytes 0x20150E 7766
bytes 0x30150E 0000
bytes 0x218000 88
bytes 0x318000 00
# the chain read round twice with the byte channel off (its bytes
# change with the core: not compared here; snes-savestate moves it):
# each read shifts its byte back in, so the state is as before, which the
# tone after the thaw shows; still frozen, the WRAM byte kept
bytes 0x140000 00
bytes 0x300000 
bytes 0x300800 
bytes 0x300800 
bytes 0x140000 01
bytes 0x301F00 00
bytes 0x35FFF0 00
# thaw: the game runs on (its tone checked in the run's second half:
# --expect-tone, --expect-hdmi-tone)
bytes 0x140050 00
bytes 0x140000 00
ctrl 0
